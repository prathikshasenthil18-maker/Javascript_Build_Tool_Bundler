{
  "name": "javascript-build-tool-bundler",
  "version": "1.0.0",
  "private": true,
  "description": "Scenario 2 Split-Versions Build Tool / Bundler \u2014 JS_FE24_BE22 (FE Node 24 / BE Node 22). Tools: diff-cover, eslint, eslint-plugin-security, eslint-plugin-sonarjs, jscpd, lizard, mocha, npm-audit, npm-ls, nyc, pydriller, stryker-js.",
  "scripts": {
    "prebuild": "node build.js --validate-only",
    "build": "node build.js --build",
    "test": "mocha",
    "test:coverage": "nyc --reporter=text --reporter=lcov --reporter=json-summary mocha",
    "lint": "eslint \"shared/**/*.js\" \"backend_js/src/**/*.js\" \"frontend_js/src/**/*.js\" \"src/**/*.js\" \"test/**/*.js\" \"build.js\"",
    "lint:security": "eslint -c .eslintrc.security.cjs \"shared/**/*.js\" \"backend_js/src/**/*.js\" \"tool-fixtures/**/*.js\"",
    "lint:sonarjs": "eslint -c .eslintrc.sonarjs.cjs \"shared/**/*.js\" \"backend_js/src/**/*.js\" \"tool-fixtures/**/*.js\"",
    "jscpd": "jscpd --config .jscpd.json shared backend_js/src frontend_js/src src tool-fixtures",
    "stryker": "stryker run stryker.conf.json",
    "audit": "npm audit --json",
    "ls": "npm ls --all --json",
    "lizard": "lizard shared backend_js/src frontend_js/src src tool-fixtures",
    "pydriller": "python tools/pydriller/run.py",
    "diff-cover": "diff-cover coverage/lcov.info --html-report coverage/diff-cover.html",
    "start:backend": "node backend_js/src/server.js",
    "start:frontend": "npm --prefix frontend_js run preview -- --host 127.0.0.1 --port 5173",
    "tools:list": "node -e \"console.log(require('./tool-matrix.json').tools.join('\\n'))\"",
    "tool:diff-cover": "bash tools/diff-cover/run.sh",
    "tool:eslint": "bash tools/eslint/run.sh",
    "tool:eslint-plugin-security": "bash tools/eslint-plugin-security/run.sh",
    "tool:eslint-plugin-sonarjs": "bash tools/eslint-plugin-sonarjs/run.sh",
    "tool:jscpd": "bash tools/jscpd/run.sh",
    "tool:lizard": "bash tools/lizard/run.sh",
    "tool:mocha": "bash tools/mocha/run.sh",
    "tool:npm-audit": "bash tools/npm-audit/run.sh",
    "tool:npm-ls": "bash tools/npm-ls/run.sh",
    "tool:nyc": "bash tools/nyc/run.sh",
    "tool:pydriller": "bash tools/pydriller/run.sh",
    "tool:stryker-js": "bash tools/stryker-js/run.sh"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^3.0.1",
    "eslint-plugin-sonarjs": "^1.0.4",
    "mocha": "^10.8.2",
    "chai": "^4.5.0",
    "nyc": "^17.1.0",
    "jscpd": "^4.0.5",
    "@stryker-mutator/core": "^8.7.1",
    "@stryker-mutator/mocha-runner": "^8.7.1"
  }
}
